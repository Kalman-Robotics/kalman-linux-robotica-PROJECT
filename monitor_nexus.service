# Misión Nexus — Parte 2
# Unidad local de systemd para administrar el monitor desde WSL2 o Ubuntu.
# Nunca se instala dentro de Nexus.
#
# Completa únicamente las zonas delimitadas con:
#   >>> TU CONFIGURACIÓN
#   <<< FIN DE TU CONFIGURACIÓN

[Unit]
Description=Monitor local del robot Nexus
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple

# >>> TU CONFIGURACIÓN — EL USUARIO
# Con qué usuario ejecutará el monitor: el tuyo. `whoami` te dice cómo se llama.
User=
# <<< FIN DE TU CONFIGURACIÓN

# >>> TU CONFIGURACIÓN — LA RUTA Y EL INTERVALO
# El comando que lanzará el servicio, en una sola línea: la ruta completa hasta tu
# monitor_nexus.sh, un espacio, y el intervalo que mediste. Completa, no ./algo:
# el servicio no se ejecuta desde tu carpeta.
ExecStart=
# <<< FIN DE TU CONFIGURACIÓN

# Reinicia únicamente cuando el monitor informa un fallo. El límite situado en
# Unit evita reintentos indefinidos si la sesión con el robot ya no está activa.
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
