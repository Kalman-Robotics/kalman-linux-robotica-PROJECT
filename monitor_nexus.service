# Misión Nexus — Parte 2
# Unidad local de systemd para administrar el monitor desde WSL2 o Ubuntu.
# Nunca se instala dentro de Nexus.
#
# Completa únicamente las zonas delimitadas con:
#   >>> TU CONFIGURACIÓN
#   <<< FIN DE TU CONFIGURACIÓN

[Unit]
Description=Monitor local del robot Nexus
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple

# >>> TU CONFIGURACIÓN — EL USUARIO
# El servicio necesita saber con qué usuario ejecutar el monitor. Es el tuyo, el
# de esta computadora. Si no recuerdas cómo se llama, `whoami` te lo dice.
User=
# <<< FIN DE TU CONFIGURACIÓN

# >>> TU CONFIGURACIÓN — LA RUTA Y EL INTERVALO
# Aquí va el comando que lanzará el servicio, todo en una sola línea: primero la
# ruta completa hasta tu monitor_nexus.sh, un espacio, y después el intervalo en
# segundos que mediste.
#
# La ruta tiene que ser completa. El servicio no se ejecuta desde tu carpeta, así
# que no entendería algo como ./monitor_nexus.sh
ExecStart=
# <<< FIN DE TU CONFIGURACIÓN

# Reinicia únicamente cuando el monitor informa un fallo. El límite situado en
# Unit evita reintentos indefinidos si la sesión con el robot ya no está activa.
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
